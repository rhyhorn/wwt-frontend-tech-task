{
	"name": "WinWinTravel frontend test task",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"lint:all": "eslint . --report-unused-disable-directives --max-warnings 0",
		"lint:file": "eslint --report-unused-disable-directives --max-warnings 0",
		"format:all": "prettier --log-level warn --write .",
		"format:file": "prettier --log-level warn --write",
		"format:check:all": "prettier --log-level warn --check .",
		"preview": "vite preview",
		"prepare": "husky",
		"test": "vitest",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.104.5",
		"date-fns": "^4.4.0",
		"i18next": "^26.5.11",
		"immer": "^11.2.9",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-i18next": "^17.1.9",
		"react-router": "^8.5.0",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/eslint-plugin-query": "^5.104.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript-eslint/eslint-plugin": "^8.72.0",
		"@typescript-eslint/parser": "^8.72.0",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"@vitest/coverage-istanbul": "^5.0.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-i18next": "^6.1.5",
		"eslint-plugin-prefer-arrow": "^1.2.3",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"jsdom": "^30.1.3",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.5",
		"vite-plugin-svgr": "^5.2.0",
		"vitest": "^5.0.5"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"npm run format:file",
			"npm run lint:file"
		]
	}
}
